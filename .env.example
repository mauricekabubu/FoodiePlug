GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Neon pooled URL for web requests; use DATABASE_URL_UNPOOLED for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Set to True only for a command that should connect with DATABASE_URL_UNPOOLED.
NEON_USE_UNPOOLED_DATABASE=False
