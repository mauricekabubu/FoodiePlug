# Copy this file to .env and set a generated secret before starting.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SITE_DOMAIN=localhost:8080
SITE_URL=http://localhost:8080
PORT=8080

# Optional image storage. Set this in your ignored local .env and on Render.
# Replace the placeholders with the Cloudinary API environment variable.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# SQLite data is copied from foodplanner/db.sqlite3 into the persistent
# Docker volume on first startup. SQLite does not use database credentials.
SQLITE_DATABASE_PATH=/data/db.sqlite3

# Existing values in foodplanner/.env are inherited. Set these in this root
# .env only when you need to override the existing provider configuration.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=30
# AI_MAX_OUTPUT_TOKENS=2048
# AI_TEMPERATURE=0.4
# FOODIEPLUG_CREDENTIALS_ENCRYPTION_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# SendGrid SMTP (use a SendGrid API key as EMAIL_HOST_PASSWORD; never commit it).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Set this to the sender address verified in SendGrid.
DEFAULT_FROM_EMAIL=FoodiePlug <no-reply@example.com>

# Enable these only when HTTPS is correctly terminated in front of the app.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
